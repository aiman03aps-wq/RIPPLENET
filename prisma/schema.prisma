generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         String // volunteer | camp_manager | admin
  name         String
  phone        String
  campId       Int?
  available    Boolean   @default(true)
  camp         Camp?     @relation(fields: [campId], references: [id])
  tasks        Request[] @relation("VolunteerRequests")
  createdAt    DateTime  @default(now())
}

model Camp {
  id        Int              @id @default(autoincrement())
  name      String
  district  String
  province  String
  lat       Float
  lng       Float
  phone     String
  capacity  Int
  occupancy Int
  status    String           @default("open") // open | full
  managers  User[]
  requests  Request[]
  stock     StockItem[]
  restocks  RestockRequest[]
  complaints Complaint[]
}

model Request {
  id          Int       @id @default(autoincrement())
  code        String    @unique // RIP-2026-00001
  citizenName String
  phone       String
  type        String // medical | food | water | rescue | shelter
  priority    String    @default("high") // low | medium | high | critical
  needs       String // JSON array of need labels
  location    String? // human-readable address label
  district    String
  lat         Float
  lng         Float
  peopleCount Int       @default(1)
  status      String    @default("pending") // pending | assigned | in_transit | resolved | cancelled
  campId      Int?
  camp        Camp?     @relation(fields: [campId], references: [id])
  volunteerId Int?
  volunteer   User?     @relation("VolunteerRequests", fields: [volunteerId], references: [id])
  assignedAt  DateTime?
  startedAt   DateTime?
  resolvedAt  DateTime?
  resolution  String? // JSON of resolve payload
  createdAt   DateTime  @default(now())
}

model Complaint {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  citizenName String
  phone       String
  message     String
  category    String    @default("service")
  campId      Int?
  camp        Camp?     @relation(fields: [campId], references: [id])
  status      String    @default("open") // open | resolved
  response    String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model StockItem {
  id           Int    @id @default(autoincrement())
  campId       Int
  camp         Camp   @relation(fields: [campId], references: [id])
  name         String
  category     String // medical | food | water | shelter
  quantity     Int
  unit         String // tabs, sachets, packs, bottles, units
  reorderLevel Int
}

model RestockRequest {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  campId    Int
  camp      Camp     @relation(fields: [campId], references: [id])
  itemName  String
  quantity  Int
  status    String   @default("pending") // pending | approved | fulfilled
  createdAt DateTime @default(now())
}

model MissingSignalAlert {
  id                Int                   @id @default(autoincrement())
  district          String
  province          String?
  exposureCategory  String                // "high" | "moderate" | "low" | "insufficient_data"
  exposureScore     Float?                // numerical exposure index 0-1 (e.g. 0.85)
  dataSource        String                @default("NDMA Inundation Telemetry / Sentinel-1 SAR (Simulated)")
  dataTimestamp     DateTime              @default(now())
  sosCount          Int                   @default(0)
  monitoringStart   DateTime
  monitoringEnd     DateTime
  reason            String
  status            String                @default("pending") // pending | under_verification | verified | dismissed | escalated
  verificationNotes String?
  reviewerName      String?
  reviewerId        Int?
  actions           MissingSignalAction[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model MissingSignalAction {
  id         Int                @id @default(autoincrement())
  alertId    Int
  alert      MissingSignalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  action     String             // "alert_created" | "verification_initiated" | "status_updated" | "notes_recorded"
  notes      String?
  actorName  String
  createdAt  DateTime           @default(now())
}
